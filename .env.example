# This workflow uses n8n's built-in Credential Manager for Discord and Google Gemini
# (OAuth2 / API key credentials), so those aren't plain env vars — set them up in n8n's
# Credentials section instead. This file documents what you'll need overall:

# Marketaux API (hardcoded directly in the HTTP Request node's query parameters —
# replace the placeholder there, this is not an n8n credential)
MARKETAUX_API_KEY=your_marketaux_api_key_here
MARKETAUX_WATCHLIST_SYMBOLS=AAPL,TSLA,MSFT,NVDA

# Google Gemini credential (set up in n8n Credentials, connected to the
# "Google Gemini Chat Model" node)
# No key needed here — configure via n8n's Google PaLM/Gemini credential type

# Discord OAuth2 credential (set up in n8n Credentials, connected to all 4 Discord nodes)
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_BULLISH_CHANNEL_ID=your_bullish_channel_id_here
DISCORD_BEARISH_CHANNEL_ID=your_bearish_channel_id_here
DISCORD_NEUTRAL_CHANNEL_ID=your_neutral_channel_id_here
DISCORD_HIGH_IMPACT_CHANNEL_ID=your_high_impact_channel_id_here
